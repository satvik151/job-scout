    hydrate();
  }, [hydrate]);

  return (
    <QueryClientProvider client={queryClient}>
      <AnimatePresence mode="wait">
        <Outlet />
      </AnimatePresence>
      <Toaster theme="dark" position="bottom-right" richColors />
    </QueryClientProvider>
  );
}
